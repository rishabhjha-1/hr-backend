generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Employee {
  id         String   @id @default(uuid())
  fullName   String
  jobTitle   String
  country    String
  salary     Float
  department String
  email      String   @unique
  hireDate   DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([country])
  @@index([jobTitle])
  @@index([country, jobTitle])
}
